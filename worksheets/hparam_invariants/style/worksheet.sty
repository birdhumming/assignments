\newcommand{\rankchainfour}{\rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox}
\newcommand{\rankchainfive}{\rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox}
\newcommand{\rankchainsix}{\rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox\ \rankopbox\ \rankbox}
\newcommand{\shortblank}[1][1.35in]{\rule{#1}{0.5pt}}
\newcommand{\answerarea}[1]{%
